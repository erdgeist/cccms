<% if @page.assets.images.any? %>
  <div id="asset_credits">
    <% @page.assets.images.each do |image| %>
      <% credit = asset_credit(image) %>
      <% next unless credit %>
      <div id="credit_for_asset_<%= image.id %>"
           class="glightbox-desc<%= " headline_credit" if image == @headline_asset %>">
        <%= credit %>
      </div>
    <% end %>
  </div>
<% end %>
