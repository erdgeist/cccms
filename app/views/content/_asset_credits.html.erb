<% if @page.assets.images.any? %>
  <div id="asset_credits">
    <% @page.assets.images.each do |image| %>
      <div id="credit_for_asset_<%= image.id %>"
          class="asset_credit_block<%= " headline_credit" if image == @headline_asset %>">
        <%= asset_credit(image) %>
      </div>
    <% end %>
  </div>
<% end %>
