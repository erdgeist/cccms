<div id="admin_layout">
  <h1><%= t(".title") %></h1>

  <%= form_for(@asset, :html => { :multipart => true }) do |f| %>
    <%= form_error_messages(f) %>

    <div class="layout_row">
      <div class="layout_row_label"><%= f.label :name %></div>
      <div class="layout_row_content"><%= f.text_field :name %></div>
    </div>

    <div class="layout_row">
      <div class="layout_row_label"><%= f.label :upload %></div>
      <div class="layout_row_content">
        <div id="asset_dropzone">
          <%= f.file_field :upload %>
          <p class="field_hint"><%= t("assets.form.drop_hint") %></p>
        </div>
      </div>
    </div>

    <div class="layout_row">
      <div class="layout_row_label"><%= f.label :creator %></div>
      <div class="layout_row_content"><%= f.text_field :creator %></div>
    </div>

    <div class="layout_row">
      <div class="layout_row_label"><%= f.label :source_url %></div>
      <div class="layout_row_content"><%= f.text_field :source_url %></div>
    </div>

    <div class="layout_row">
      <div class="layout_row_label"><%= f.label :license_key %></div>
      <div class="layout_row_content">
        <%= f.select :license_key,
              options_for_select(
                [[t("assets.form.none_option"), ""]] + AssetLicense.keys.map { |key| [t("asset_licenses.#{key}"), key] },
                @asset.license_key
              ) %>
      </div>
    </div>

    <div class="layout_row">
      <div class="layout_row_label"><%= t("assets.form.attach_to_page") %></div>
      <div class="layout_row_content">
        <div class="restore_picker">
          <%= text_field_tag :asset_node_search_term, @attach_node&.title,
                :placeholder => t("assets.form.attach_search_placeholder"), :autocomplete => "off" %>
          <div id="asset_node_search_results" class="search_results" style="display: none"></div>
        </div>
        <%= hidden_field_tag :node_id, @attach_node&.id %>
        <span class="field_hint"><%= t("assets.form.attach_hint") %></span>
      </div>
    </div>

    <div class="layout_row">
      <div class="layout_row_label"></div>
      <div class="layout_row_content">
        <label><%= check_box_tag :headline, "1" %> <%= t("assets.form.as_headline") %></label>
        <span class="field_hint"><%= t("assets.form.headline_hint") %></span>
      </div>
    </div>

    <div class="layout_row">
      <div class="layout_row_label"><%= t("admin.columns.actions") %></div>
      <div class="layout_row_content info_group">
        <div class="info_group_items">
          <div class="info_item"><%= f.submit t("admin.common.create") %></div>
          <div class="info_item"><%= link_to t("admin.common.back"), assets_path %></div>
        </div>
      </div>
    </div>
  <% end %>
</div>
