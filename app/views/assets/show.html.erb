<div id="page_editor">
  <h1><%= @asset.name %></h1>

  <div id="content">
    <div class="node_description">Actions</div>
    <div class="node_content node_info_group">
      <div class="node_info_group_items">
        <div class="node_info_item">
        <%= link_to edit_asset_path(@asset), class: 'action_button' do %>
          <%= icon("edit", library: "tabler", "aria-hidden": true) %> Edit
        <% end %>
        </div>
        <div class="node_info_item">
          <%= link_to 'Back', assets_path %>
        </div>
      </div>
    </div>

    <div class="node_description">Thumbnail</div>
    <% if @asset.has_variant?(:medium) %>
      <div class="node_description">Thumbnail</div>
      <div class="node_content"><%= image_tag @asset.upload.url(:medium), style: "max-width: 300px; max-height: 300px;" %></div>
    <% end %>

    <div class="node_description">Public Path</div>
    <div class="node_content">
      <% public_path = @asset.upload.url.sub(/\?\d+$/, "") %>
      <%= link_to public_path, public_path, target: "_blank", rel: "noopener" %>
      <button type="button" class="action_button copy_button"
              data-copy-url="<%= request.base_url + public_path %>">
        <%= icon("copy", library: "tabler", "aria-hidden": true) %>
        <span class="copy_button_label">Copy URL</span>
      </button>
    </div>

    <div class="node_description">Creator</div>
    <div class="node_content"><%= @asset.creator.presence || "—" %></div>

    <div class="node_description">Source</div>
    <div class="node_content">
      <% if @asset.source_url.present? %>
        <%= link_to @asset.source_url, @asset.source_url %>
      <% else %>
        —
      <% end %>
    </div>

    <div class="node_description">License</div>
    <div class="node_content">
      <% if (license = AssetLicense.find(@asset.license_key)) %>
        <%= t("asset_licenses.#{license.key}") %>
      <% else %>
        —
      <% end %>
    </div>

    <div class="node_description">Content Type</div>
    <div class="node_content"><%= @asset.upload.content_type %></div>

    <div class="node_description">Size</div>
    <div class="node_content"><%= "#{@asset.upload.size/1024} KB" %></div>
  </div>
</div>
