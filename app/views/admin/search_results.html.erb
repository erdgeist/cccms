<h1><%= t(".title") %></h1>

<ul class="search_results_list">
  <% @results.each do |result| %>
    <li>
      <%= link_to title_for_node(result), node_path(result) %>
      <span class="field_hint"><%= link_to_path("#{result.unique_name} ↗", result.unique_name) %></span>
    </li>
  <% end %>
</ul>
