<div id="login_form">
  <%= form_tag session_path do -%>
    <% if flash[:error] %>
      <div class="error_messages"><%= flash[:error] %></div>
    <% end %>

    <div class="node_description">Login</div>
    <div class="node_content"><%= text_field_tag 'login', @login %></div>

    <div class="node_description">Password</div>
    <div class="node_content"><%= password_field_tag 'password', nil %></div>

    <div class="node_content"><%= submit_tag 'log in' %></div>
  <% end -%>
</div>
