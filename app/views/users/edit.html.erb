<h1>Edit existing user</h1>

<% if @user.errors.any? %>
  <div class="error_messages">
    <ul><% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
  </div>
<% end %>

<div id="page_editor">
  <%= form_for @user do |f| %>
  <div id="content">
    <div class="node_description">Login</div>
    <div class="node_content"><%= f.text_field :login %></div>

    <div class="node_description">E-Mail</div>
    <div class="node_content"><%= f.text_field :email %></div>

    <div class="node_description">Password</div>
    <div class="node_content"><%= f.password_field :password %></div>

    <div class="node_description">Confirm</div>
    <div class="node_content"><%= f.password_field :password_confirmation %></div>

    <% if current_user.admin? %>
    <div class="node_description">Admin?</div>
    <div class="node_content"><%= f.check_box :admin %></div>
    <% end %>

    <div class="node_description"></div>
    <div class="node_content"><%= f.submit "Update" %></div>
  <% end %>
  </div>
</div>
