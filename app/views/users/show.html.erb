<div id="admin_layout">
  <h1><%= @user.login %></h1>

  <div id="content">
    <div class="layout_row_label">Actions</div>
    <div class="layout_row_content info_group">
      <div class="info_group_items">
        <div class="info_item">
        <%= link_to edit_user_path(@user), class: 'action_button' do %>
          <%= icon("edit", library: "tabler", "aria-hidden": true) %> Edit
        <% end %>
        </div>
      </div>
    </div>

    <div class="layout_row_label">Login</div>
    <div class="layout_row_content"><%= @user.login %></div>

    <div class="layout_row_label">E-Mail</div>
    <div class="layout_row_content"><%= @user.email %></div>

    <div class="layout_row_label">Admin?</div>
    <div class="layout_row_content"><%= @user.admin ? "yes" : "no" %></div>
  </div>
</div>
