<div id="page_editor">
  <h1><%= @user.login %></h1>

  <div id="content">
    <div class="node_description">Actions</div>
    <div class="node_content node_info_group">
      <div class="node_info_group_items">
        <div class="node_info_item">
        <%= link_to edit_user_path(@user), class: 'action_button' do %>
          <%= icon("edit", library: "tabler", "aria-hidden": true) %> Edit
        <% end %>
        </div>
      </div>
    </div>

    <div class="node_description">Login</div>
    <div class="node_content"><%= @user.login %></div>

    <div class="node_description">E-Mail</div>
    <div class="node_content"><%= @user.email %></div>

    <div class="node_description">Admin?</div>
    <div class="node_content"><%= @user.admin ? "yes" : "no" %></div>
  </div>
</div>
