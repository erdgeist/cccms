<h1>Create new user</h1>

<% if @user.errors.any? %>
  <div class="error_messages">
    <ul><% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
  </div>
<% end %>

<div id="admin_layout">
  <%= form_for @user do |f| %>
  <div id="content">
    <div class="layout_row_label">Login</div>
    <div class="layout_row_content"><%= f.text_field :login %></div>

    <div class="layout_row_label">E-Mail</div>
    <div class="layout_row_content"><%= f.text_field :email %></div>

    <div class="layout_row_label">Password</div>
    <div class="layout_row_content"><%= f.password_field :password %></div>

    <div class="layout_row_label">Confirm</div>
    <div class="layout_row_content"><%= f.password_field :password_confirmation %></div>

    <div class="layout_row_label">Admin?</div>
    <div class="layout_row_content"><%= f.check_box :admin %></div>

    <div class="layout_row_label"></div>
    <div class="layout_row_content"><%= f.submit "Create" %></div>
  <% end %>
  </div>
</div>
