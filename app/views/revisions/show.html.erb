<div id="page_editor" class="show_node">
  <h1>Revision <%= @page.revision %>: <%= @page.title %></h1>

  <div id="content">
    <div class="node_description">Actions</div>
    <div class="node_content node_info_group">
      <div class="node_info_group_items">
        <div class="node_info_item">
          <%= link_to 'Show all revisions', node_revisions_path(@node) %>
        </div>
      </div>
    </div>

    <div class="node_description">Path</div>
    <div class="node_content"><%= @page.public_link %></div>

    <div class="node_description">Author</div>
    <div class="node_content"><%= @page.user.try(:login) %></div>

    <div class="node_description">Editor</div>
    <div class="node_content"><%= @page.editor.try(:login) %></div>

    <div class="node_description">Last updated</div>
    <div class="node_content"><%= @page.updated_at %></div>

    <div class="node_description">Published at</div>
    <div class="node_content"><%= @page.published_at %></div>

    <div class="node_description">Title</div>
    <div class="node_content"><%= @page.title %></div>

    <div class="node_description">Abstract</div>
    <div class="node_content"><%= @page.abstract %></div>

    <div class="node_description">Body</div>
    <div class="node_content"><%= @page.body %></div>
  </div>
</div>
