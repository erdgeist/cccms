<h1>Compare — <%= title_for_node(@node) %></h1>

<p class="node_action_bar standalone_action_bar"><%= link_to 'View revision history', node_revisions_path(@node, :locale => @locale) %></p>

<div class="translation_compare">
  <div class="translation_compare_column">
    <h2><%= @locale.to_s.upcase %></h2>
    <div class="node_description">Title</div>
    <div class="node_content"><%= @translation&.title %></div>

    <div class="node_description">Abstract</div>
    <div class="node_content"><%= sanitize(@translation&.abstract.to_s) %></div>

    <div class="node_description">Body</div>
    <div class="node_content"><%= sanitize(@translation&.body.to_s) %></div>
  </div>

  <div class="translation_compare_column">
    <h2><%= I18n.default_locale.to_s.upcase %> (default)</h2>
    <div class="node_description">Title</div>
    <div class="node_content"><%= @default_translation&.title %></div>

    <div class="node_description">Abstract</div>
    <div class="node_content"><%= sanitize(@default_translation&.abstract.to_s) %></div>

    <div class="node_description">Body</div>
    <div class="node_content"><%= sanitize(@default_translation&.body.to_s) %></div>
  </div>
</div>
