<h1><%= t(".title") %> — <%= title_for_node(@node) %></h1>

<p class="node_action_bar"><%= link_to t("page_translations.revision_history_link"), node_revisions_path(@node, :translation_locale => @locale) %></p>

<div class="translation_compare">
  <div class="translation_compare_column">
    <h2><%= @locale.to_s.upcase %></h2>
    <div class="layout_row">
      <div class="layout_row_label"><%= Page.human_attribute_name(:title) %></div>
      <div class="layout_row_content"><%= @translation&.title %></div>
    </div>

    <div class="layout_row">
      <div class="layout_row_label"><%= Page.human_attribute_name(:abstract) %></div>
      <div class="layout_row_content"><%= sanitize(@translation&.abstract.to_s) %></div>
    </div>

    <div class="layout_row">
      <div class="layout_row_label"><%= Page.human_attribute_name(:body) %></div>
      <div class="layout_row_content"><%= sanitize(@translation&.body.to_s) %></div>
    </div>
  </div>

  <div class="translation_compare_column">
    <h2><%= I18n.default_locale.to_s.upcase %> (<%= t(".default_marker") %>)</h2>
    <div class="layout_row">
      <div class="layout_row_label"><%= Page.human_attribute_name(:title) %></div>
      <div class="layout_row_content"><%= @default_translation&.title %></div>
    </div>

    <div class="layout_row">
      <div class="layout_row_label"><%= Page.human_attribute_name(:abstract) %></div>
      <div class="layout_row_content"><%= sanitize(@default_translation&.abstract.to_s) %></div>
    </div>

    <div class="layout_row">
      <div class="layout_row_label"><%= Page.human_attribute_name(:body) %></div>
      <div class="layout_row_content"><%= sanitize(@default_translation&.body.to_s) %></div>
    </div>
  </div>
</div>
