<h1><%= t(".title") %></h1>

<%= form_for @menu_item do |f| %>
  <div class="layout_row_label"><%= t("admin.common.search") %></div>
  <div class="layout_row_content">
    <%= text_field_tag :menu_search_term %>
    <div id="menu_item_search_results" class="search_results"></div>
  </div>

  <div class="layout_row_label"><%= MenuItem.human_attribute_name(:node_id) %></div>
  <div class="layout_row_content"><%= f.text_field :node_id %></div>

  <div class="layout_row_label"><%= MenuItem.human_attribute_name(:path) %></div>
  <div class="layout_row_content"><%= f.text_field :path %></div>

  <div class="layout_row_label"><%= MenuItem.human_attribute_name(:title) %></div>
  <div class="layout_row_content"><%= f.text_field :title %></div>

  <div class="layout_row_content"><%= f.submit t("admin.common.create") %></div>
<% end %>
