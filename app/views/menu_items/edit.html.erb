<h1>Edit Menu Item</h1>

<div id="page_editor">
  <%= form_for @menu_item do |f| %>
  <div id="content">
    <div class="node_description">Search</div>
    <div class="node_content">
      <%= text_field_tag :menu_search_term %>
      <div id="search_results"></div>
    </div>

    <div class="node_description">Node Id</div>
    <div class="node_content"><%= f.text_field :node_id %></div>

    <div class="node_description">Path</div>
    <div class="node_content"><%= f.text_field :path %></div>

    <div class="node_description">Title</div>
    <div class="node_content"><%= f.text_field :title %></div>

    <div class="node_description"></div>
    <div class="node_content"><%= f.submit 'Update' %></div>
  <% end %>
  </div>
</div>
